# Salin menjadi .env lalu isi. File .env tidak pernah di-commit.

# Kunci Gemini dari https://aistudio.google.com/apikey
# Kosongkan untuk memakai ringkasan templat tanpa AI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Tombol "Coba langsung" (masuk demo tanpa sandi) di halaman Masuk. Isi 0 untuk mematikan.
DEMO_LOGIN=1

# Kata sandi akun demo kalau ingin masuk manual (demo.rina, demo.budi, ...).
DEMO_PASSWORD=

# Port server (default 8787).
PORT=8787
